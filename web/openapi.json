{
  "components": {
    "schemas": {
      "AuthenticationVerificationDto": {
        "description": "Pydantic transport contract for a completed passkey authentication.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": ["csrf_token"],
        "title": "AuthenticationVerificationDto",
        "type": "object"
      },
      "ChallengeDto": {
        "properties": {
          "challenge_id": {
            "title": "Challenge Id",
            "type": "string"
          },
          "options": {
            "additionalProperties": true,
            "title": "Options",
            "type": "object"
          }
        },
        "required": ["challenge_id", "options"],
        "title": "ChallengeDto",
        "type": "object"
      },
      "CredentialRequest": {
        "properties": {
          "challenge_id": {
            "title": "Challenge Id",
            "type": "string"
          },
          "credential": {
            "additionalProperties": true,
            "title": "Credential",
            "type": "object"
          }
        },
        "required": ["challenge_id", "credential"],
        "title": "CredentialRequest",
        "type": "object"
      },
      "DecisionCaseVersionBundle": {
        "additionalProperties": false,
        "description": "The complete version set that participates in replay identity.",
        "properties": {
          "agent_definition_id": {
            "title": "Agent Definition Id",
            "type": "string"
          },
          "agent_definition_version": {
            "title": "Agent Definition Version",
            "type": "string"
          },
          "case_contract_version": {
            "title": "Case Contract Version",
            "type": "string"
          },
          "host_application_version": {
            "title": "Host Application Version",
            "type": "string"
          },
          "host_contract_version": {
            "title": "Host Contract Version",
            "type": "string"
          },
          "host_source_sha": {
            "title": "Host Source Sha",
            "type": "string"
          },
          "m_agent_release_commit": {
            "title": "M Agent Release Commit",
            "type": "string"
          },
          "m_agent_version": {
            "title": "M Agent Version",
            "type": "string"
          },
          "m_agent_wheel_sha256": {
            "title": "M Agent Wheel Sha256",
            "type": "string"
          },
          "m_agent_wheel_url": {
            "title": "M Agent Wheel Url",
            "type": "string"
          },
          "model_adapter_id": {
            "title": "Model Adapter Id",
            "type": "string"
          },
          "output_contract_version": {
            "title": "Output Contract Version",
            "type": "string"
          },
          "report_projection_contract_version": {
            "title": "Report Projection Contract Version",
            "type": "string"
          },
          "routing_policy_version": {
            "title": "Routing Policy Version",
            "type": "string"
          }
        },
        "required": [
          "case_contract_version",
          "host_contract_version",
          "host_application_version",
          "host_source_sha",
          "agent_definition_id",
          "agent_definition_version",
          "model_adapter_id",
          "routing_policy_version",
          "output_contract_version",
          "report_projection_contract_version",
          "m_agent_version",
          "m_agent_wheel_url",
          "m_agent_wheel_sha256",
          "m_agent_release_commit"
        ],
        "title": "DecisionCaseVersionBundle",
        "type": "object"
      },
      "EvidenceClock": {
        "additionalProperties": false,
        "description": "The immutable fact, publication, acquisition, and validation clocks.",
        "properties": {
          "acquired_at": {
            "title": "Acquired At",
            "type": "string"
          },
          "fact_effective_at": {
            "title": "Fact Effective At",
            "type": "string"
          },
          "source_published_at": {
            "title": "Source Published At",
            "type": "string"
          },
          "validated_at": {
            "title": "Validated At",
            "type": "string"
          }
        },
        "required": ["fact_effective_at", "source_published_at", "acquired_at", "validated_at"],
        "title": "EvidenceClock",
        "type": "object"
      },
      "ExternalResult": {
        "additionalProperties": false,
        "description": "The user-visible result expected from this original synthetic fixture.",
        "properties": {
          "key_reasons": {
            "items": {
              "type": "string"
            },
            "title": "Key Reasons",
            "type": "array"
          },
          "outcome_code": {
            "title": "Outcome Code",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": ["outcome_code", "summary", "key_reasons"],
        "title": "ExternalResult",
        "type": "object"
      },
      "FormalReport": {
        "additionalProperties": false,
        "description": "Read-only delivery projection derived from one committed host event.",
        "properties": {
          "business_object_id": {
            "title": "Business Object Id",
            "type": "string"
          },
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "corrects_event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corrects Event Id"
          },
          "event_id": {
            "title": "Event Id",
            "type": "string"
          },
          "evidence_clock": {
            "$ref": "#/components/schemas/EvidenceClock"
          },
          "framework_run_id": {
            "title": "Framework Run Id",
            "type": "string"
          },
          "generated_at": {
            "title": "Generated At",
            "type": "string"
          },
          "knowledge_cutoff": {
            "title": "Knowledge Cutoff",
            "type": "string"
          },
          "qualification_scope": {
            "title": "Qualification Scope",
            "type": "string"
          },
          "report_version_id": {
            "title": "Report Version Id",
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/ExternalResult"
          },
          "stage_results": {
            "items": {
              "$ref": "#/components/schemas/StageResult"
            },
            "title": "Stage Results",
            "type": "array"
          },
          "synthetic": {
            "title": "Synthetic",
            "type": "boolean"
          },
          "version_bundle": {
            "$ref": "#/components/schemas/DecisionCaseVersionBundle"
          }
        },
        "required": [
          "report_version_id",
          "event_id",
          "business_object_id",
          "framework_run_id",
          "case_id",
          "synthetic",
          "qualification_scope",
          "generated_at",
          "knowledge_cutoff",
          "evidence_clock",
          "version_bundle",
          "result",
          "stage_results"
        ],
        "title": "FormalReport",
        "type": "object"
      },
      "GateResult": {
        "additionalProperties": false,
        "description": "One deterministic gate evaluated during a saved decision stage.",
        "properties": {
          "gate_id": {
            "title": "Gate Id",
            "type": "string"
          },
          "status": {
            "enum": ["PASSED", "FAILED", "UNKNOWN"],
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["gate_id", "status"],
        "title": "GateResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ReauthenticationVerificationDto": {
        "description": "Pydantic transport contract for a completed recent reauthentication.",
        "properties": {
          "credential_id": {
            "title": "Credential Id",
            "type": "string"
          }
        },
        "required": ["credential_id"],
        "title": "ReauthenticationVerificationDto",
        "type": "object"
      },
      "SafetyCapabilitiesDiagnosticDto": {
        "description": "Machine-readable official-project safety invariants.",
        "properties": {
          "order_writing": {
            "title": "Order Writing",
            "type": "boolean"
          },
          "public_recommendation_service": {
            "title": "Public Recommendation Service",
            "type": "boolean"
          },
          "single_user": {
            "title": "Single User",
            "type": "boolean"
          }
        },
        "required": ["single_user", "public_recommendation_service", "order_writing"],
        "title": "SafetyCapabilitiesDiagnosticDto",
        "type": "object"
      },
      "SessionRefreshDto": {
        "description": "Pydantic transport contract for a CSRF-protected idle-session refresh.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status"],
        "title": "SessionRefreshDto",
        "type": "object"
      },
      "StageResult": {
        "additionalProperties": false,
        "description": "A phase-specific outcome; lifecycle states have no global terminal meaning.",
        "properties": {
          "gate_results": {
            "items": {
              "$ref": "#/components/schemas/GateResult"
            },
            "title": "Gate Results",
            "type": "array"
          },
          "phase": {
            "enum": [
              "FRAMEWORK_RUN",
              "HOST_VALIDATION",
              "BUSINESS_COMMIT",
              "PUBLICATION",
              "NOTIFICATION",
              "CORRECTION"
            ],
            "title": "Phase",
            "type": "string"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "status": {
            "enum": [
              "CREATED",
              "RUNNING",
              "WAITING",
              "SUCCEEDED",
              "REJECTED",
              "ABSTAINED",
              "FAILED",
              "PENDING",
              "EXPIRED",
              "EXECUTION_BLOCKED",
              "UNKNOWN",
              "CANCELLED"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["phase", "status", "gate_results", "reasons"],
        "title": "StageResult",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionDiagnosticDto": {
        "description": "Pydantic-only transport contract for the public diagnostic interface.",
        "properties": {
          "application_version": {
            "title": "Application Version",
            "type": "string"
          },
          "m_agent_release_commit": {
            "title": "M Agent Release Commit",
            "type": "string"
          },
          "m_agent_version": {
            "title": "M Agent Version",
            "type": "string"
          },
          "m_agent_wheel_sha256": {
            "title": "M Agent Wheel Sha256",
            "type": "string"
          },
          "m_agent_wheel_url": {
            "title": "M Agent Wheel Url",
            "type": "string"
          },
          "source_sha": {
            "title": "Source Sha",
            "type": "string"
          }
        },
        "required": [
          "application_version",
          "source_sha",
          "m_agent_version",
          "m_agent_wheel_url",
          "m_agent_wheel_sha256",
          "m_agent_release_commit"
        ],
        "title": "VersionDiagnosticDto",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Stock Profiler",
    "version": "0.1.0.dev0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/passkeys/authentication/options": {
      "post": {
        "operationId": "authentication_options_api_v1_auth_passkeys_authentication_options_post",
        "parameters": [
          {
            "in": "header",
            "name": "origin",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Origin"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChallengeDto"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No enrolled passkey is available"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Authentication Options"
      }
    },
