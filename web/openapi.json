{
  "components": {
    "schemas": {
      "ChallengeDto": {
        "properties": {
          "challenge_id": {
            "title": "Challenge Id",
            "type": "string"
          },
          "options": {
            "additionalProperties": true,
            "title": "Options",
            "type": "object"
          }
        },
        "required": ["challenge_id", "options"],
        "title": "ChallengeDto",
        "type": "object"
      },
      "CredentialRequest": {
        "properties": {
          "challenge_id": {
            "title": "Challenge Id",
            "type": "string"
          },
          "credential": {
            "additionalProperties": true,
            "title": "Credential",
            "type": "object"
          }
        },
        "required": ["challenge_id", "credential"],
        "title": "CredentialRequest",
        "type": "object"
      },
      "DecisionCaseVersionBundle": {
        "additionalProperties": false,
        "description": "The complete version set that participates in replay identity.",
        "properties": {
          "agent_definition_id": {
            "title": "Agent Definition Id",
            "type": "string"
          },
          "agent_definition_version": {
            "title": "Agent Definition Version",
            "type": "string"
          },
          "case_contract_version": {
            "title": "Case Contract Version",
            "type": "string"
          },
          "host_contract_version": {
            "title": "Host Contract Version",
            "type": "string"
          },
          "m_agent_release_commit": {
            "title": "M Agent Release Commit",
            "type": "string"
          },
          "m_agent_version": {
            "title": "M Agent Version",
            "type": "string"
          },
          "output_contract_version": {
            "title": "Output Contract Version",
            "type": "string"
          }
        },
        "required": [
          "case_contract_version",
          "host_contract_version",
          "agent_definition_id",
          "agent_definition_version",
          "output_contract_version",
          "m_agent_version",
          "m_agent_release_commit"
        ],
        "title": "DecisionCaseVersionBundle",
        "type": "object"
      },
      "EvidenceClock": {
        "additionalProperties": false,
        "description": "The immutable fact, publication, acquisition, and validation clocks.",
        "properties": {
          "acquired_at": {
            "title": "Acquired At",
            "type": "string"
          },
          "fact_effective_at": {
            "title": "Fact Effective At",
            "type": "string"
          },
          "source_published_at": {
            "title": "Source Published At",
            "type": "string"
          },
          "validated_at": {
            "title": "Validated At",
            "type": "string"
          }
        },
        "required": ["fact_effective_at", "source_published_at", "acquired_at", "validated_at"],
        "title": "EvidenceClock",
        "type": "object"
      },
      "ExternalResult": {
        "additionalProperties": false,
        "description": "The user-visible result expected from this original synthetic fixture.",
        "properties": {
          "key_reasons": {
            "items": {
              "type": "string"
            },
            "title": "Key Reasons",
            "type": "array"
          },
          "outcome_code": {
            "title": "Outcome Code",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": ["outcome_code", "summary", "key_reasons"],
        "title": "ExternalResult",
        "type": "object"
      },
      "FormalReport": {
        "additionalProperties": false,
        "description": "Read-only delivery projection derived from one committed host event.",
        "properties": {
          "business_object_id": {
            "title": "Business Object Id",
            "type": "string"
          },
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "event_id": {
            "title": "Event Id",
            "type": "string"
          },
          "evidence_clock": {
            "$ref": "#/components/schemas/EvidenceClock"
          },
          "framework_run_id": {
            "title": "Framework Run Id",
            "type": "string"
          },
          "generated_at": {
            "title": "Generated At",
            "type": "string"
          },
          "knowledge_cutoff": {
            "title": "Knowledge Cutoff",
            "type": "string"
          },
          "qualification_scope": {
            "title": "Qualification Scope",
            "type": "string"
          },
          "report_version_id": {
            "title": "Report Version Id",
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/ExternalResult"
          },
          "synthetic": {
            "title": "Synthetic",
            "type": "boolean"
          },
          "version_bundle": {
            "$ref": "#/components/schemas/DecisionCaseVersionBundle"
          }
        },
        "required": [
          "report_version_id",
          "event_id",
          "business_object_id",
          "framework_run_id",
          "case_id",
          "synthetic",
          "qualification_scope",
          "generated_at",
          "knowledge_cutoff",
          "evidence_clock",
          "version_bundle",
          "result"
        ],
        "title": "FormalReport",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HostGrantRequest": {
        "properties": {
          "purpose": {
            "enum": ["bootstrap", "recovery"],
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": ["purpose"],
        "title": "HostGrantRequest",
        "type": "object"
      },
      "SafetyCapabilitiesDiagnosticDto": {
        "description": "Machine-readable official-project safety invariants.",
        "properties": {
          "order_writing": {
            "title": "Order Writing",
            "type": "boolean"
          },
          "public_recommendation_service": {
            "title": "Public Recommendation Service",
            "type": "boolean"
          },
          "single_user": {
            "title": "Single User",
            "type": "boolean"
          }
        },
        "required": ["single_user", "public_recommendation_service", "order_writing"],
        "title": "SafetyCapabilitiesDiagnosticDto",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionDiagnosticDto": {
        "description": "Pydantic-only transport contract for the public diagnostic interface.",
        "properties": {
          "application_version": {
            "title": "Application Version",
            "type": "string"
          },
          "m_agent_release_commit": {
            "title": "M Agent Release Commit",
            "type": "string"
          },
          "m_agent_version": {
            "title": "M Agent Version",
            "type": "string"
          },
          "m_agent_wheel_sha256": {
            "title": "M Agent Wheel Sha256",
            "type": "string"
          },
          "m_agent_wheel_url": {
            "title": "M Agent Wheel Url",
            "type": "string"
          },
          "source_sha": {
            "title": "Source Sha",
            "type": "string"
          }
        },
        "required": [
          "application_version",
          "source_sha",
          "m_agent_version",
          "m_agent_wheel_url",
          "m_agent_wheel_sha256",
          "m_agent_release_commit"
        ],
        "title": "VersionDiagnosticDto",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Stock Profiler Diagnostics",
