{
  "name": "stock-profiler-web",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest --run --browser.enabled",
    "test:unit": "vitest --run",
    "test:e2e": "playwright test",
    "generate-client": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "latest",
    "@vitejs/plugin-react": "latest",
    "openapi-fetch": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/browser-playwright": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "openapi-typescript": "latest",
    "playwright": "latest",
    "prettier": "latest",
    "typescript": "5.9.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
